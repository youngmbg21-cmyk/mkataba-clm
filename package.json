{
  "name": "hati-clm",
  "version": "0.2.0",
  "description": "HaTi — Contract Lifecycle Management platform for the Kenyan market",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/chromium/redline-verify.js",
    "test:selection": "node test/chromium/selection-verify.js",
    "test:parity": "node test/chromium/parity-verify.js",
    "test:all": "npm test && npm run test:browser && npm run test:selection && npm run test:parity"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.19.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.0"
  }
}
