# Copy this file to .env and fill in the real values.
# Never commit .env — it is already in .gitignore.

# --- Supabase (safe to expose: these two are public by design) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-side only. NEVER prefix these with VITE_ ---
# VITE_ variables are baked into the browser bundle and are public.
# These are read by the Netlify function only.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
