{
  "name": "hati-clm",
  "version": "0.2.0",
  "description": "HaTi \u2014 Contract Lifecycle Management platform for the Kenyan market",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/chromium/redline-verify.js",
    "test:selection": "node test/chromium/selection-verify.js",
    "test:parity": "node test/chromium/parity-verify.js",
    "test:timeline": "node test/chromium/timeline-verify.js",
    "test:structure": "node test/chromium/structure-verify.js",
    "test:standardpaper": "node test/chromium/standard-paper-verify.js",
    "test:designstep": "node test/chromium/designstep-verify.js",
    "test:all": "npm run lint && npm test && node test/chromium/run-all.js",
    "test:browser:all": "node test/chromium/run-all.js",
    "test:live": "node test/chromium/live-verify.js",
    "test:laptops": "node test/chromium/laptops-verify.js",
    "test:phone": "node test/chromium/phone-verify.js",
    "test:newcontract": "node test/chromium/newcontract-verify.js",
    "test:themetokens": "node test/chromium/theme-tokens-verify.js",
    "test:swedish": "node test/chromium/swedish-verify.js",
    "test:sharerecipient": "node test/chromium/share-recipient-verify.js",
    "test:insights": "node test/chromium/insights-panels-verify.js",
    "test:cardcollapse": "node test/chromium/card-collapse-verify.js",
    "test:roomnotices": "node test/chromium/room-order-and-notices-verify.js",
    "test:papergrows": "node test/chromium/paper-grows-verify.js",
    "test:cpbell": "node test/chromium/counterparty-bell-verify.js",
    "test:historyhead": "node test/chromium/history-head-verify.js",
    "test:kpifour": "node test/chromium/kpi-four-verify.js",
    "test:settingstabs": "node test/chromium/settings-tabs-verify.js",
    "test:settingsholds": "node test/chromium/settings-holds-still-verify.js",
    "test:amendment": "node test/chromium/amendment-journey-verify.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.19.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.0"
  }
}
