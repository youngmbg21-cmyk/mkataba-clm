!.env.example
# Secrets — never commit real keys. .env.example (placeholders only) is tracked.
.env
.env.*
node_modules/
package-lock.json
scratchpad/
server/data-*/
server/data/

# Chromium verification screenshots — regenerated by test/chromium/verify.js
test/chromium/shots/

# Language-coverage readout — regenerated by test/chromium/lang-coverage.js
test/chromium/lang-coverage.json

# Screenshot output — regenerated on demand by test/chromium/shots-*.js
test/chromium/shots/

# End-to-end verification screenshots — regenerated by the scripts alongside
# them under test/e2e-evidence/. The scripts, raw logs and notes ARE tracked;
# the images are not, for the same reason test/chromium/shots/ is not.
test/e2e-evidence/**/shots/
